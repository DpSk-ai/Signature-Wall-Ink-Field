+  s: Sig;
+  paused: boolean;
+  finish: (id: string) => void;
+  error: (m: string) => void;
+}) {
+  return (
+    <div
+      data-id={s.id}
+      className={"signature " + s.status}
+      style={{
+        left: s.x,
+        top: s.y,
+        width: s.width,
+        height: s.height,
+        transform: `rotate(${s.rotation}deg)`,
+      }}
+    >
+      <InkCanvas
+        s={s}
+        replay={retry}
+        paused={paused}
+        onFinish={() => finish(s.id)}
+        onError={error}
+      />
+    </div>
+  );
+});
+export function Wall() {
+  const state = useLive(),
+    ref = useRef<HTMLCanvasElement>(null),
+    [warning, setWarning] = useState("");
