+  useEffect(() => {
+    let active = true;
+    const c = ref.current!,
+      ctx = c.getContext("2d")!;
+    const draw = () => {
+      if (active) drawBoard(ctx, state, state.online, signUrl());
+    };
+    let frame = 0;
+    prepareBoard()
+      .then(() => {
+        if (active) frame = requestAnimationFrame(draw);
+      })
+      .catch(() => {
+        if (active) {
+          setWarning("展签字体加载中");
+          schedule();
+        }
+      });
