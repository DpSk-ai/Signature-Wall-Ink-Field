+            paused={state.animationPaused || !state.online}
+            finish={complete}
+            error={setWarning}
+          />
+        ))}
+        {warning && (
+          <p className="wall-note" role="status">
+            {warning}
+          </p>
+        )}
+      </div>
+    </main>
+  );
+}
