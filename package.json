{
  "name": "signature-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"vite\" \"node --watch --import tsx server/index.ts\"",
    "build": "tsc -b && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "vitest run",
    "test:api": "node tests/api-suite.mjs",
    "test:e2e": "node tests/e2e-suite.mjs",
    "test:backend": "node tests/backend-regression.mjs",
    "typecheck": "tsc -b --force",
    "test:exhibit": "node tests/exhibit.mjs",
    "test:controls": "node tests/exhibit-controls.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.2.0",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "playwright": "^1.65.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
  }
}
